<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DTP.ViewModels"
             x:DataType="vm:Step3ReviewViewModel"
             x:Class="DTP.Views.Step3ReviewView">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>
        
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D3D3D"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="250, 4, *" Margin="8">
        
        <!-- Linke Seite: Übriger Pool                      -->
        <Border Grid.Column="0" Background="#242424" CornerRadius="4" Padding="8" BoxShadow="0 0 2 0 #000000">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="Übriger Teile Pool" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding LeftoverPool}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E" CornerRadius="4" Margin="0,0,0,10" BorderBrush="#333" BorderThickness="1">
                                    <Grid RowDefinitions="Auto, *">
                                        <!-- Header -->
                                        <Border Grid.Row="0" Background="#333333" Padding="8,6" CornerRadius="4,4,0,0" BorderBrush="#444" BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding PartName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                        
                                        <!-- Drag & Drop Liste -->
                                        <ListBox Grid.Row="1" ItemsSource="{Binding SerialNumbers}" 
                                                 Background="Transparent" BorderThickness="0" Padding="4"
                                                 DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" PointerPressed="OnItemPointerPressed" PointerMoved="OnItemPointerMoved">
                                                        <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Background="#1A1A1A" ResizeDirection="Columns"/>

        <!-- Rechte Seite: Aufträge    -->
        <Border Grid.Column="2" Background="Transparent" CornerRadius="4">
            <ScrollViewer Margin="0 0 -4 0" >
                
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            
                            <!-- Auftragskarte -->
                            <Border Background="#242424" CornerRadius="4" Padding="10" Margin="4,4,12,10" HorizontalAlignment="Stretch" BoxShadow="0 0 2 0 #000000">
                                <Grid ColumnDefinitions="220, 1, *">
                                    
                                    <!-- Stammdaten -->
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,15,0">
                                        <Border Background="#333333" Padding="8,6" CornerRadius="4 0 0 0" Margin="-10,-10,-15,0">
                                            <TextBlock Text="{Binding OrderName}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                        
                                        <ItemsControl ItemsSource="{Binding LocalMetadata}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="90, *" Margin="0,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding Key, StringFormat='{}{0}:'}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value}" Height="22" MinHeight="22" FontSize="11" CornerRadius="3" BorderThickness="0" Padding="6,2" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#444" Width="1" Margin="0,-10,0,-10"/>

                                    <!-- Zugeordnete Teile -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto, *" Margin="15,0,0,0">
                                        <Border Background="#2C2C2C" Padding="8,6" CornerRadius="0 4 0 0" Margin="-15,-10,-10,0">
                                            <TextBlock Text="Zugeordnete Teile &amp; Seriennummern:" Foreground="White" FontSize="12"/>
                                        </Border>

                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding AssignedParts}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1E1E1E" CornerRadius="4" Width="180" Margin="0,0,10,0" BorderBrush="#333" BorderThickness="1" VerticalAlignment="Top">
                                                            <Grid RowDefinitions="Auto, *">
                                                                <!-- Header -->
                                                                <Border Grid.Row="0" Background="#333333" Padding="8,6" CornerRadius="4,4,0,0" BorderBrush="#444" BorderThickness="0,0,0,1">
                                                                    <TextBlock Text="{Binding PartName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                                                </Border>
                                                                
                                                                <!-- Drag & Drop Liste -->
                                                                <ListBox Grid.Row="1" ItemsSource="{Binding SerialNumbers}" 
                                                                         Background="Transparent" BorderThickness="0" Padding="4"
                                                                         DragDrop.AllowDrop="True" DragDrop.DragOver="OnDragOver" DragDrop.Drop="OnDrop">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="Transparent" PointerPressed="OnItemPointerPressed" PointerMoved="OnItemPointerMoved">
                                                                                <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                    
                                </Grid>
                            </Border>
                            
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>