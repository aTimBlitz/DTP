<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DTP.ViewModels"
             x:DataType="vm:Step4ExportViewModel"
             x:Class="DTP.Views.Step4ExportView">

    <Grid>
        <!-- Hauptbereich -->
        <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="8">
            
            <!-- Ziel Ordner -->
            <Border Grid.Row="0" Background="#242424" CornerRadius="4" Padding="12,6" Margin="0,0,0,10" BoxShadow="0 0 2 0 #000000">
                <StackPanel Spacing="8">
                    <TextBlock Text="Ziel-Ordner für den Export" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0" Text="{Binding ExportFolderPath}" Watermark="Bitte einen Ordner auswählen..." MinHeight="24" Height="24" FontSize="12" CornerRadius="4,0,0,4" VerticalContentAlignment="Center" BorderThickness="0"/>
                        <Button Grid.Column="1" Command="{Binding SelectExportFolderCommand}" Content="Durchsuchen" Background="#333" Foreground="White" CornerRadius="0,4,4,0" FontSize="12" Height="24" Padding="12,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Vorlagen Liste -->
            <Border Grid.Row="1" Background="#242424" CornerRadius="4" Padding="12,6" Margin="0,0,0,10" BoxShadow="0 0 2 0 #000000">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="Dokument-Vorlagen (*.docx, *.xlsx)" Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding AddTemplatesCommand}" Content="Vorlagen laden" Background="#0078D7" Foreground="White" FontSize="10" Padding="12,6" CornerRadius="4"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding SelectedTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E1E" CornerRadius="4" Padding="10" Margin="0,0,0,8" BorderBrush="#333" BorderThickness="1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Grid.Column="0" Spacing="6">
                                                <!-- Dateiname -->
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="Bold" FontSize="13"/>

                                                <!-- Platzhalter-->
                                                    <TextBlock Text="Erkannte Platzhalter (Grün = Befüllt | Orange = Ist leer | Grau = Nicht im Datenbestand):" Foreground="Gray" FontSize="11"/>                                                <ItemsControl ItemsSource="{Binding FoundPlaceholders}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" Margin="-2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding BackgroundColor}" CornerRadius="10" Padding="6,2" Margin="2" ToolTip.Tip="{Binding Name}">
                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsGlobal}" 
                                                      Content="Globales Dokument" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"
                                                      Command="{Binding DataContext.RefreshPlaceholderStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      x:CompileBindings="False" />
                                            </StackPanel>
                                           
                                            <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:Step4ExportViewModel)DataContext).RemoveTemplateCommand}" 
                                                    CommandParameter="{Binding}" Content="X" Background="Transparent" Foreground="#D32F2F" Width="24" VerticalAlignment="Stretch" CornerRadius="4" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Export Optionen -->
            <Border Grid.Row="2" Background="#242424" CornerRadius="4" Padding="12,6" Margin="0,0,0,10" BoxShadow="0 0 2 0 #000000">
                <StackPanel Spacing="8">
                    <TextBlock Text="Export-Optionen" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    <CheckBox Content="Für jeden Auftrag ein einzelnes Dokument erzeugen" IsChecked="{Binding GenerateSingleFiles}" Foreground="White" FontSize="12"/>
                    <CheckBox Content="Ein Master-Dokument erzeugen (Alle Aufträge in einer Datei / Combined)" IsChecked="{Binding GenerateCombinedFile}" Foreground="White" FontSize="12"/>
                    <TextBlock Text="Hinweis: Du kannst auch nur das Master-Dokument erzeugen, wenn du Einzeldokumente abwählst!" Foreground="Gray" FontSize="10" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Start Button -->
            <Button Grid.Row="3" Command="{Binding StartExportCommand}" Content="Export Generieren" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,6" CornerRadius="4"/>
        </Grid>

        <!-- Overlay für Ladebalken/Export -->
        <Border Background="#D9000000" IsVisible="{Binding IsExporting}" ZIndex="100">
            <Border Background="#1A1A1A" CornerRadius="8" Width="500" Height="150" BoxShadow="0 0 30 0 #000000" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="*, Auto" Margin="20">
                    
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="16">
                        <TextBlock Text="{Binding ExportStatusText}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <ProgressBar Value="{Binding ExportProgress}" Minimum="0" Maximum="100" Height="8" CornerRadius="16" Foreground="#2196F3" Background="#333"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding IsExportFinished}">
                        <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" Background="Transparent" FontSize="12" Foreground="White" Padding="12,6" CornerRadius="4"/>                        
                        <Button Content="Neuen Export starten" Command="{Binding ResetExportCommand}" Background="Transparent" FontSize="12" Foreground="White" Padding="12,6" CornerRadius="4"/>
                    </StackPanel>
                    
                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>